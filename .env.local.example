# Fase 1 — obligatorias para correr la app.
# Se consiguen en el dashboard de Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Fase 3 — obligatorias para /tv.
# NEXT_PUBLIC_SITE_URL: la URL pública del deploy (ej. https://inesaliva50.vercel.app),
# se usa para armar el QR que se muestra en la esquina de /tv.
# NEXT_PUBLIC_TV_KEY: la clave que va en /tv?key=<esto>. Cualquier string sirve,
# no es seguridad real, solo evita que alguien caiga ahí por accidente.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TV_KEY=

# Fase 4 — recién hacen falta cuando construyamos /admin. Dejarlas vacías
# hasta entonces está bien.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
